ARB_APP_NAME=H2ORB – H2O Result Browser
ARB_ENVIRONMENT=development
ARB_HOST=127.0.0.1
ARB_PORT=8000
ARB_LOG_LEVEL=INFO

ARB_AQUA_BASE_URL=https://aqua.example.invalid
ARB_AQUA_WEB_BASE_URL=https://app.aqua-cloud.io/aquaWebNG
ARB_NOISE_MARKER=[NOISE]
ARB_AQUA_USERNAME=
ARB_AQUA_PASSWORD=
ARB_AQUA_VERIFY_TLS=true
# Optional inside a container, for example: /certificates/company-ca.pem
# ARB_AQUA_CA_BUNDLE=/certificates/company-ca.pem
ARB_AQUA_TIMEOUT_SECONDS=30
ARB_AQUA_MAX_CONNECTIONS=20
